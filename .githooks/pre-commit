#!/usr/bin/env sh

set -eu

root_dir=$(git rev-parse --show-toplevel)

printf '%s\n' 'Updating backend lockfile and formatting backend...'
(
  cd "$root_dir/backend"
  uv lock
  uv sync
  .venv/bin/ruff format .
  .venv/bin/ruff check --fix .
)

printf '%s\n' 'Updating frontend lockfile and formatting frontend...'
(
  cd "$root_dir/frontend"
  corepack enable
  corepack prepare pnpm@11.1.2 --activate
  pnpm install --lockfile-only
  pnpm format
)

git -C "$root_dir" add backend frontend
