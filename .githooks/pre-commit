#!/bin/sh
set -e

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "❌ Not in a git repository"
  exit 1
}

info()   { printf "\033[1;34m→\033[0m %s\n" "$1"; }
ok()     { printf "\033[1;32m✓\033[0m %s\n" "$1"; }
warn()   { printf "\033[1;33m!\033[0m %s\n" "$1"; }
fail()   { printf "\033[1;31m✗\033[0m %s\n" "$1"; exit 1; }

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
  info "No staged files, skipping pre-commit hook"
  exit 0
fi

# ── helpers ──────────────────────────────────────────────────────
need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    case "$1" in
      node)  fail "$1 not found. Install Node.js from https://nodejs.org/ or via your package manager" ;;
      go)    fail "$1 not found. Install Go from https://go.dev/dl/ or via your package manager" ;;
      *)     fail "$1 not found. Install $1 and ensure it is in PATH" ;;
    esac
  fi
  ok "$1 found"
}

autoinstall() {
  if ! command -v "$1" >/dev/null 2>&1; then
    info "installing $1 via $2"
    eval "$2"
    if ! command -v "$1" >/dev/null 2>&1; then
      fail "failed to install $1 (installed binary not in PATH)"
    fi
    ok "$1 installed"
  else
    ok "$1 found"
  fi
}

list_staged_matches() {
  printf '%s\n' "$STAGED_FILES" | grep -E "$1" || true
}

ensure_pnpm_project_ready() {
  if [ ! -d "$1/node_modules" ]; then
    info "$2 node_modules missing, running pnpm install"
    (cd "$1" && pnpm install --frozen-lockfile) || (cd "$1" && pnpm install)
    ok "pnpm install finished for $2"
  fi
}

need_cmd git

BACKEND_GO_FILES="$(list_staged_matches '^backend/.*\.go$')"
BACKEND_MOD_FILES="$(list_staged_matches '^backend/(go\.mod|go\.sum)$')"
FRONTEND_FILES="$(list_staged_matches '^frontend/.*\.(json|js|ts|tsx|html|yaml|css)$')"
FRONTEND_ESLINT_FILES="$(list_staged_matches '^frontend/.*\.(js|ts|tsx)$')"
ADMIN_FILES="$(list_staged_matches '^admin/.*\.(json|js|ts|tsx|html|yaml|css)$')"
ADMIN_ESLINT_FILES="$(list_staged_matches '^admin/.*\.(js|ts|tsx)$')"

if [ -n "$BACKEND_GO_FILES$BACKEND_MOD_FILES" ]; then
  echo ""
  info "Checking Go prerequisites"

  need_cmd go

  GO_VERSION_OK="$(
    go version 2>/dev/null | sed -n 's/.*go\([0-9]\+\.[0-9]\+\(\.[0-9]\+\)*\).*/\1/p' | {
      read -r v
      case "$v" in
        1.26*|1.2[7-9]*|1.[3-9][0-9]*|[2-9]*) echo "ok" ;;
        *) echo "" ;;
      esac
    }
  )"
  if [ -z "$GO_VERSION_OK" ]; then
    for sdk in "$HOME/sdk/go1.26.0" /usr/local/go1.26.0 /opt/go1.26.0; do
      if [ -x "$sdk/bin/go" ]; then
        info "using Go from $sdk"
        export PATH="$sdk/bin:$PATH"
        GO_VERSION_OK="ok"
        break
      fi
    done
  fi
  if [ -z "$GO_VERSION_OK" ]; then
    warn "Go 1.26+ required (found: $(go version 2>/dev/null || echo 'not found'))."
    warn "Set GOROOT or install from https://go.dev/dl/"
    info "trying anyway — GOTOOLCHAIN=auto may fetch the right version"
  fi

  GOBIN="$(go env GOBIN 2>/dev/null || echo "")"
  [ -z "$GOBIN" ] && GOBIN="$(go env GOPATH)/bin"
  export PATH="$GOBIN:$PATH"

  autoinstall gofumpt 'go install mvdan.cc/gofumpt@latest'

  if [ -n "$BACKEND_MOD_FILES" ]; then
    echo ""
    info "Running go mod tidy"
    cd "$ROOT_DIR/backend"
    go mod tidy
    git add go.mod go.sum
    ok "go.mod / go.sum refreshed"
  fi

  if [ -n "$BACKEND_GO_FILES" ]; then
    echo ""
    info "Formatting staged Go files with gofumpt"
    cd "$ROOT_DIR"
    printf '%s\n' "$BACKEND_GO_FILES" | xargs gofumpt -w
    printf '%s\n' "$BACKEND_GO_FILES" | xargs git add --
    ok "staged Go files formatted"
  fi
fi

if [ -n "$FRONTEND_FILES$FRONTEND_ESLINT_FILES$ADMIN_FILES$ADMIN_ESLINT_FILES" ]; then
  echo ""
  info "Checking Node.js prerequisites"

  need_cmd node

  if ! command -v pnpm >/dev/null 2>&1; then
    if command -v corepack >/dev/null 2>&1; then
      info "installing pnpm via corepack"
      corepack enable
      hash -r 2>/dev/null || true
    elif command -v npm >/dev/null 2>&1; then
      info "installing pnpm via npm (user-local)"
      mkdir -p "$HOME/.npm-global"
      npm_config_prefix="$HOME/.npm-global" npm install -g pnpm
      export PATH="$HOME/.npm-global/bin:$PATH"
      hash -r 2>/dev/null || true
    else
      fail "pnpm not found. Install it via: npm install -g pnpm  (you may need to set npm's prefix first)"
    fi
    if ! command -v pnpm >/dev/null 2>&1; then
      fail "pnpm installed but not found in PATH after install. Try adding ~/.npm-global/bin to your PATH"
    fi
    ok "pnpm installed"
  else
    ok "pnpm found"
  fi
fi

if [ -n "$FRONTEND_FILES$FRONTEND_ESLINT_FILES" ]; then
  ensure_pnpm_project_ready "$ROOT_DIR/frontend" "frontend"

  if [ -n "$FRONTEND_ESLINT_FILES" ]; then
    echo ""
    info "Fixing staged frontend JS/TS with eslint"
    cd "$ROOT_DIR/frontend"
    printf '%s\n' "$FRONTEND_ESLINT_FILES" | sed 's#^frontend/##' | xargs pnpm exec eslint --fix --
  fi

  if [ -n "$FRONTEND_FILES" ]; then
    echo ""
    info "Formatting staged frontend files with prettier"
    cd "$ROOT_DIR/frontend"
    printf '%s\n' "$FRONTEND_FILES" | sed 's#^frontend/##' | xargs pnpm exec prettier --write --
  fi

  cd "$ROOT_DIR"
  { printf '%s\n' "$FRONTEND_FILES"; printf '%s\n' "$FRONTEND_ESLINT_FILES"; } | sed '/^$/d' | sort -u | xargs git add --
  ok "staged frontend files formatted"

  echo ""
  info "Running frontend tests (vitest run)"
  cd "$ROOT_DIR/frontend"
  pnpm exec vitest run || fail "frontend tests failed — commit aborted"
  ok "frontend tests passed"
fi

if [ -n "$ADMIN_FILES$ADMIN_ESLINT_FILES" ]; then
  ensure_pnpm_project_ready "$ROOT_DIR/admin" "admin"

  if [ -n "$ADMIN_ESLINT_FILES" ]; then
    echo ""
    info "Fixing staged admin JS/TS with eslint"
    cd "$ROOT_DIR/admin"
    printf '%s\n' "$ADMIN_ESLINT_FILES" | sed 's#^admin/##' | xargs pnpm exec eslint --fix --
  fi

  if [ -n "$ADMIN_FILES" ]; then
    echo ""
    info "Formatting staged admin files with prettier"
    cd "$ROOT_DIR/admin"
    printf '%s\n' "$ADMIN_FILES" | sed 's#^admin/##' | xargs pnpm exec prettier --write --
  fi

  cd "$ROOT_DIR"
  { printf '%s\n' "$ADMIN_FILES"; printf '%s\n' "$ADMIN_ESLINT_FILES"; } | sed '/^$/d' | sort -u | xargs git add --
  ok "staged admin files formatted"

  echo ""
  info "Running admin tests (vitest run)"
  cd "$ROOT_DIR/admin"
  pnpm exec vitest run || fail "admin tests failed — commit aborted"
  ok "admin tests passed"
fi

# ── stage everything ──────────────────────────────────────────────
echo ""
info "Staging formatted files"
cd "$ROOT_DIR"
git add --update
ok "ready to commit"
echo ""
