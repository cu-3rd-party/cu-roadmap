#!/bin/sh
set -e

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "❌ Not in a git repository"
  exit 1
}

info()   { printf "\033[1;34m→\033[0m %s\n" "$1"; }
ok()     { printf "\033[1;32m✓\033[0m %s\n" "$1"; }
warn()   { printf "\033[1;33m!\033[0m %s\n" "$1"; }
fail()   { printf "\033[1;31m✗\033[0m %s\n" "$1"; exit 1; }

ZERO="0000000000000000000000000000000000000000"

# ── collect files changed in the commits being pushed ────────────
# pre-push feeds "<local ref> <local oid> <remote ref> <remote oid>" on stdin.
CHANGED_FILES=""
while read -r _local_ref local_oid _remote_ref remote_oid; do
  [ -z "$local_oid" ] && continue
  # branch deletion — nothing to test
  [ "$local_oid" = "$ZERO" ] && continue

  if [ "$remote_oid" = "$ZERO" ]; then
    # new branch on remote: diff against commits not already on any remote ref
    range="$(git rev-list "$local_oid" --not --remotes 2>/dev/null | tail -n 1)"
    if [ -n "$range" ]; then
      files="$(git diff --name-only "$range^" "$local_oid" 2>/dev/null || git diff --name-only "$local_oid" 2>/dev/null)"
    else
      files="$(git show --name-only --pretty=format: "$local_oid" 2>/dev/null)"
    fi
  else
    files="$(git diff --name-only "$remote_oid" "$local_oid" 2>/dev/null)"
  fi

  CHANGED_FILES="$CHANGED_FILES
$files"
done

FRONTEND_FILES="$(printf '%s\n' "$CHANGED_FILES" | grep -E '^frontend/.*\.(json|js|ts|tsx|html|yaml|css)$' || true)"

if [ -z "$FRONTEND_FILES" ]; then
  info "No frontend changes in pushed commits, skipping frontend tests"
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  fail "node not found. Install Node.js from https://nodejs.org/ or via your package manager"
fi
if ! command -v pnpm >/dev/null 2>&1; then
  fail "pnpm not found. Install it via: npm install -g pnpm"
fi

if [ ! -d "$ROOT_DIR/frontend/node_modules" ]; then
  info "frontend node_modules missing, running pnpm install"
  (cd "$ROOT_DIR/frontend" && pnpm install --frozen-lockfile) || (cd "$ROOT_DIR/frontend" && pnpm install)
  ok "pnpm install finished for frontend"
fi

echo ""
info "Running frontend tests (vitest run)"
cd "$ROOT_DIR/frontend"
pnpm exec vitest run || fail "frontend tests failed — push aborted"
ok "frontend tests passed"
echo ""
