{
  "name": "cu-roadmap-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && cross-env VITE_API=server vite build",
    "docker:build": "docker build -f Dockerfile -t culib:latest .",
    "docker:run-local": "docker run -p 8080:80 culib:latest",
    "preview": "vite preview",
    "dev:host": "vite --host",
    "dev:mock": "cross-env VITE_API=mock vite",
    "dev:noauth": "cross-env VITE_NO_AUTH=true vite",
    "dev:mock:noauth": "cross-env VITE_API=mock VITE_NO_AUTH=true vite",
    "msw:cleanup": "rm public/mockServiceWorker.js",
    "msw:gen": "pnpm exec msw init public --save",
    "test": "vitest",
    "format:eslint": "pnpm lint:eslint --fix",
    "format:check": "prettier --check .",
    "format:prettier": "prettier \"**/*.{json,js,ts,tsx,html,yaml,css}\" --write",
    "format": "pnpm format:eslint && pnpm format:prettier",
    "lint:eslint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:prettier": "prettier \"**/*.{json,js,ts,tsx}\" --check --write",
    "lint:ts": "tsc --noEmit",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:ts",
    "generate": "vite generate",
    "clean": "rimraf node_modules",
    "plop": "plop",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "translate": "pnpm lingui:extract && pnpm lingui:compile"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "uuid": "^14.0.0",
    "vis-network": "^10.1.0",
    "workbox-window": "^7.3.0",
    "zod": "^4.4.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lingui/babel-plugin-lingui-macro": "^5.6.0",
    "@lingui/vite-plugin": "^5.9.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "msw": "^2.11.6",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.5",
    "workbox-build": "^7.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
