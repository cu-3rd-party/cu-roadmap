; Workspace root. Adding a dep now needs an explicit target:
;   pnpm --filter cu-roadmap-frontend add <pkg>
;   pnpm --filter @cu/ui add <pkg>
;   pnpm -w add <pkg>            (root tooling only)
; Kept from frontend/.npmrc so `shadcn add` (a plain `pnpm add`) still works.
ignore-workspace-root-check=true
